# Contact form delivery (lib/mail.ts).
# Copy to .env.local and fill in. Without these the form logs to the terminal
# in development, and fails loudly in production rather than dropping enquiries.

# API key from https://resend.com
RESEND_API_KEY=

# Where enquiries land.
CONTACT_TO_EMAIL=studio@ateliernord.com

# A sender on a domain you've verified in Resend.
CONTACT_FROM_EMAIL=Atelier Nord <site@ateliernord.com>
